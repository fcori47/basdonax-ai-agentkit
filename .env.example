# ---------------------------------------------------------------------------
# Copiá este archivo como .env y completá SOLO el proveedor que vayas a usar.
#
#   Windows:   copy .env.example .env
#   Mac/Linux: cp .env.example .env
#
# El archivo .env está en .gitignore: nunca se sube a GitHub.
# ---------------------------------------------------------------------------


# ===========================================================================
#  1. QUÉ MODELO USA EL AGENTE
# ===========================================================================

# claude | openai | gemini
PROVEEDOR=claude

# --- Claude (Anthropic) ---  https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
MODELO_CLAUDE=claude-haiku-4-5
# (el más rápido y barato para probar; en la web elegís cualquier otro)

# --- OpenAI ---  https://platform.openai.com/api-keys
OPENAI_API_KEY=
MODELO_OPENAI=gpt-5

# --- Gemini (Google) ---  https://aistudio.google.com/apikey
GOOGLE_API_KEY=
MODELO_GEMINI=gemini-2.5-pro

# Si no sabés qué modelo poner, dejá el que viene: la plataforma de pruebas
# le pregunta al proveedor cuáles tiene hoy y te los muestra en una lista.


# ===========================================================================
#  2. DÓNDE SE GUARDAN LAS CONVERSACIONES
# ===========================================================================

# test        → SQLite: un archivo en tu computadora. No instalás nada.
# produccion  → Postgres: para cuando hay varios procesos atendiendo.
MODO=test

# --- MODO=test ---
SQLITE_RUTA=datos/conversaciones.db

# --- MODO=produccion ---
# Formato: postgresql://usuario:clave@servidor:puerto/base
POSTGRES_DSN=

# Para producción hacen falta dos paquetes que no vienen instalados:
#
#   pip install -r requirements-produccion.txt
#
# Ojo con los dos: langgraph-checkpoint-postgres tiene que ser 3.x (la 2.x
# rompe el entorno), y psycopg va con [binary] o en Windows falla con
# "no pq wrapper available". El requirements-produccion.txt ya los tiene
# con la versión correcta.


# ===========================================================================
#  3. COMPORTAMIENTO Y COSTO
# ===========================================================================

# Caché del prompt del sistema: hace que el proveedor lo guarde de su lado
# y te cobre una fracción a partir del segundo mensaje.
# (En Claude se activa a mano; en OpenAI y Gemini es automático.)
CACHE=true

# Máximo de tokens que puede escribir el agente en cada respuesta
MAX_TOKENS=4096

# Cuántos mensajes de la conversación recuerda.
# Más memoria = más contexto, pero también más costo por mensaje.
MEMORIA_MENSAJES=20

# Archivo con el prompt del sistema (la personalidad del agente).
# Se relee en cada mensaje: podés editarlo con el agente andando.
PROMPT_SISTEMA=prompts/sistema.md


# ===========================================================================
#  4. TELEGRAM
# ===========================================================================

# El token que te da @BotFather. Abrí https://t.me/BotFather, mandale
# /newbot y seguile la conversación: al final te lo pega en el chat.
#
# Con esto puesto ya podés arrancar el bot:
#
#   python bot_telegram.py
#
# Corre en tu computadora: no hace falta dominio, ni HTTPS, ni abrir puertos.
# Si no vas a usar Telegram, dejalo vacío y no pasa nada.
TELEGRAM_TOKEN=


# ===========================================================================
#  5. WHATSAPP  (con Chatwoot en el medio)
# ===========================================================================
#
# Esto es para  python webhook_chatwoot.py  y necesita un servidor con
# dominio: WhatsApp va por webhook, así que alguien tiene que poder entrar.
# Si solo vas a usar la terminal, la web o Telegram, saltealo entero.
#
# El recorrido de un mensaje:
#
#   persona → WhatsApp → Meta → Chatwoot → tu webhook → el agente
#                                  ↑                        │
#                                  └──── la respuesta ──────┘
#
# Ojo con esto, que ahorra tiempo: **el agente NO le habla a Meta**, le habla
# a Chatwoot. Por eso acá no hay token de WhatsApp, ni App Secret, ni firma
# HMAC: de eso se encarga Chatwoot cuando conectás el inbox. Vos solo
# necesitás las cuatro de Chatwoot, acá abajo.


# --- Chatwoot ---
# La dirección de tu Chatwoot, con https:// (la barra final da igual)
CHATWOOT_URL=
# Perfil → Configuración del perfil → Token de acceso a la API
CHATWOOT_TOKEN=
# El número que aparece en la URL cuando entrás: /app/accounts/1/...
CHATWOOT_CUENTA_ID=1

# El secreto que va en la URL del webhook:
#
#   https://tu-dominio.com/chatwoot/<CHATWOOT_WEBHOOK_TOKEN>
#
# Chatwoot NO firma sus webhooks, así que esto es lo único que separa un
# mensaje de verdad de cualquiera que descubra tu dominio. Generá uno largo
# y al azar, no lo escribas a mano:
#
#   python -c "import secrets; print(secrets.token_hex(24))"
#
# Si falta, es corto (menos de 32 caracteres) o es el del ejemplo del README,
# el agente no arranca: es mejor enterarse ahí que con un agente mudo.
CHATWOOT_WEBHOOK_TOKEN=

# Etiqueta que apaga al bot en una conversación (el traspaso a una persona).
# Se la ponés desde la bandeja y el agente se calla en ese chat.
CHATWOOT_ETIQUETA_HUMANO=humano


# --- Juntar los mensajes cortados ---
# La gente en WhatsApp escribe "hola" / "queria preguntar" / "por el precio"
# en tres mensajes seguidos. Sin esto el agente contesta tres veces, y las
# tres mal: recién el tercero trae la pregunta entera.
#
# Cuántos segundos espera juntando la ráfaga antes de contestar.
# Con 0 contesta cada mensaje al toque (y se pisa).
BUFFER_SEGUNDOS=8

# El puerto donde escucha el webhook. En un contenedor dejalo en 8000.
PUERTO=8000


# ===========================================================================
#  6. CÓMO RESPONDE EN WHATSAPP  (lo pregunta la instalación)
# ===========================================================================
#
# ¿Como una persona, en varios mensajes cortos, o todo en un solo mensaje?
#
# Desde el 1 de octubre de 2026, Meta cobra los mensajes que manda el agente,
# pasados los 1.000 gratis de cada mes (por número). Tres globos se leen como
# una persona, pero son hasta tres mensajes cobrados.
#
# Si la gente te llega por anuncios de clic a WhatsApp y escribe desde el
# celular, esa conversación es gratis durante 72 horas desde la primera
# respuesta, y la diferencia casi no se siente.
#
#   3 → como una persona, hasta 3 globos (va de 1 a 5)
#   1 → todo en un solo mensaje
MENSAJES_POR_RESPUESTA=3

# Cuántos mensajes de una misma persona atiende en 24 horas, en esa
# conversación (cuentan los que manda ella, no las respuestas del agente). Al
# pasarlo, le pone la etiqueta humano y deja una nota privada contando por
# qué. No se destraba sola: vuelve cuando alguien le saca la etiqueta. Frena
# al que se queda charlando de cualquier cosa: cada respuesta se paga.
# 0 = sin tope.
TOPE_MENSAJES_POR_DIA=50

# Lo que entra se recorta a este largo antes de llegar al modelo. Un texto
# pegado enorme se pagaría en ese mensaje y en todos los que siguen.
LARGO_MAXIMO_DE_ENTRADA=2000


# ===========================================================================
#  7. AVISOS POR MAIL  (lo pregunta la instalación)
# ===========================================================================
#
# Si algo se rompe (el modelo no contesta, se venció una clave, Chatwoot no
# acepta la respuesta), la persona que escribió no ve el error: la
# conversación pasa a humano, queda una nota privada y te llega un mail acá
# (de un mismo error, uno por hora como mucho). Si lo dejás vacío, el aviso
# queda solo en los registros del servidor.
AVISOS_EMAIL=

# Por dónde sale ese mail. Con Gmail: smtp.gmail.com, puerto 587 y una
# "contraseña de aplicación" — NO tu contraseña de siempre. Se saca en
# https://myaccount.google.com/apppasswords (con la verificación en dos pasos
# activada; los espacios que muestra Google no importan). No hace falta nada
# de Google Cloud.
#
# Cuando lo completes, probalo donde corre el agente (en el servidor, en la
# terminal del contenedor):   python probar_mail.py
SMTP_SERVIDOR=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
